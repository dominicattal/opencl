kernel void forward(global float* from, 
                    global float* to, 
                    global float* weights, 
                    int from_length, 
                    int to_length)
{
    int id = get_global_id(0);
    float val = 0;
    for (int i = 0; i < from_length; i++) {
        val += from[i] * weights[i*to_length+id];
    }   
    float bias = weights[from_length*to_length+id];
    val += bias;
    to[id] = val;
    to[id] = 1 / (1 + exp(-val));
}

kernel void error_zero(global float* errors, global float* signs)
{
    int id = get_global_id(0);
    errors[id] = 0;
    signs[id] = 0;
}

kernel void error_add(global float* target,
                      global float* output,
                      global float* errors,
                      global float* signs)
{
    int id = get_global_id(0);
    errors[id] += 0.5 * (target[id] - output[id]) * (target[id] - output[id]);
    signs[id] += -(target[id] - output[id]);
}

kernel void error_divide(global float* errors, int num)
{
    errors[get_global_id(0)] /= num;
}

kernel void error_differentiate(global float* errors, global float* signs)
{
    int id = get_global_id(0);
    int sgn = (1-signbit(signs[id])) * 2 - 1;
    errors[id] = sgn * sqrt(2 * errors[id]);
}

kernel void backward(global float* from,
                     global float* to,
                     global float* errors_from, 
                     global float* errors_to,
                     global float* weights,
                     int from_length,
                     int to_length,
                     float eta)
{
    int id = get_global_id(0);
    float err = 0;
    for (int i = 0; i < to_length; i++) {
        float err_wrt_out = errors_to[i];
        float out_wrt_net = to[i] * (1 - to[i]);
        float net_wrt_w = from[id];
        float err_wrt_w = err_wrt_out * out_wrt_net * net_wrt_w;
        err += err_wrt_out * out_wrt_net * weights[id*to_length+i];
        weights[id*to_length+i] -= eta * err_wrt_w;
    }
    errors_from[id] = err;
}
