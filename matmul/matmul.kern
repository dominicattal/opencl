__kernel void matmul(int N, __global float* A, __global float* B, __global float* C)
{
    int gx = get_global_id(0);
    int gy = get_global_id(1);
    float val = 0;
    for (int i = 0; i < N; i++)
    {
        val += A[gy*N+i] * B[i*N+gx];
    }
    C[gy*N+gx] = val;
}

__kernel void matmul_local(int N, __global float* A, __global float* B, __global float* C, __local float* lA, __local float* lB)
{
    int gx = get_global_id(0);
    int gy = get_global_id(1);
    int lx = get_local_id(0);
    int ly = get_local_id(1);
    int tile_width = get_local_size(0);
    float val = 0;
    for (int i = 0; i < (N/tile_width); i++) {
        lA[ly*tile_width+lx] = A[gy*N+(i*tile_width+lx)];
        lB[ly*tile_width+lx] = B[(i*tile_width+ly)*N+gx];
        barrier(CLK_LOCAL_MEM_FENCE);

        for (int j = 0; j < tile_width; j++) {
            val += lA[ly*tile_width+j] * lB[j*tile_width+lx]; 
        }
        barrier(CLK_LOCAL_MEM_FENCE);
    }

    C[gy*N+gx] = val;
}

// this has race conditions i think, also really slow
// also bricked my computer
__kernel void matmul_dim3(int N, __global float* A, __global float* B, __global float* C)
{
    int gx = get_global_id(0);
    int gy = get_global_id(1);
    int gz = get_global_id(2); 
    C[gy*N+gx] += A[gy*N+gz] * B[gz*N+gx];
}
